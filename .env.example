# ---- Vercel (frontend) ----
# Public https URL of the worker (no trailing slash)
WORKER_URL=https://your-worker.up.railway.app
# Same random string as the worker's WORKER_SECRET (32+ chars)
WORKER_SECRET=change-me-to-a-long-random-string
# Password for /studio (creating + deleting clips). Visitors never need it.
ADMIN_PASSWORD=change-me-too
# Password you give to people so they can open the library and download clips.
VIEWER_PASSWORD=change-me-viewer

# ---- Worker (Docker host) ----
# WORKER_SECRET=<same as above>
# DATA_DIR=/data             # MUST be a mounted persistent volume (clip library lives here)
# MAX_SECONDS_UHD=300        # max clip length when quality >= 1440p
# MAX_SECONDS_HD=900         # max clip length below 1440p
# MAX_CONCURRENT=1           # parallel jobs (4K MP4 transcode is CPU heavy)
# MAX_JOBS_PER_HOUR=5        # per client IP
# JOB_TIMEOUT=900            # seconds per job
# FILE_TTL=7200              # seconds before temp job files are deleted (library clips are kept)
# YTDLP_COOKIES_B64=         # base64 of cookies.txt (optional, helps with bot checks)
# PROXY_URL=                 # e.g. http://user:pass@host:port (optional)
